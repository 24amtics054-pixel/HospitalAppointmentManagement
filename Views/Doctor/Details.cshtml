@model Doctor

<h1>Doctor Details</h1>
<div class="card">
    <h2>@Model.DoctorName</h2>
    <p><strong>Doctor ID:</strong> @Model.DoctorId</p>
    <p><strong>Specialization:</strong> @Model.Specialization</p>
    <p><strong>Experience:</strong> @Model.Experience years</p>
    <p><strong>Consultation Fee:</strong> ₹@Model.ConsultationFee</p>
    <p><strong>Service Charge:</strong> ₹100</p>
    <p class="total"><strong>Total Consultation Charge:</strong> ₹@ViewBag.TotalCharge</p>

    <a class="btn" asp-controller="Appointment" asp-action="Create" asp-route-doctorId="@Model.DoctorId">Request Appointment</a>
    <a class="btn secondary" asp-action="Index">Back</a>
</div>
